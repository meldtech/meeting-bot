# Listen address (container-friendly default)
HOST=0.0.0.0
PORT=8090

# Logging (RUST_LOG targets: kair_meeting_bot, tower_http)
RUST_LOG=kair_meeting_bot=info,tower_http=info

# Optional: Kair Voice API origin with no trailing slash. Used when implementing
# callbacks to POST /sessions/{botId}/upload-audio (see INTEGRATION.md).
# KAIR_API_BASE_URL=http://localhost:8000
